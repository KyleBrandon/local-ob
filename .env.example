# --- storage ---
POSTGRES_PASSWORD=changeme

# --- embeddings ---
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768
EMBED_BASE_URL=http://host.docker.internal:11434
EMBED_API_KEY=

# --- classification ---
CLASSIFY_PROVIDER=ollama
CLASSIFY_MODEL=qwen3:8b
CLASSIFY_BASE_URL=http://host.docker.internal:11434
CLASSIFY_API_KEY=

# --- safety ---
FORCE_PROVIDER_CHANGE=false

# --- TLS (optional — only needed for claude.ai web Custom Connectors or LAN exposure) ---
# Claude Desktop is stdio-only; the Phase 10 mcp-remote shim runs over loopback HTTP, so TLS buys nothing for that path.
# Setup: brew install mkcert && mkcert -install
#        mkdir -p certs && mkcert -cert-file certs/cert.pem -key-file certs/key.pem localhost 127.0.0.1 ::1
# Uncomment the two lines below to enable HTTPS.
#TLS_CERT_FILE=/certs/cert.pem
#TLS_KEY_FILE=/certs/key.pem
